{
  "framework": "vite",
  "buildCommand": "PORT=18994 BASE_PATH=/ pnpm --filter @workspace/invoice-focus run build",
  "outputDirectory": "artifacts/invoice-focus/dist/public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.invoicefocus.com" }],
      "destination": "https://invoicefocus.com/$1",
      "permanent": true
    },
    {
      "source": "/guides",
      "destination": "/help",
      "permanent": true
    },
    {
      "source": "/invoice-generator-for-freelancers",
      "destination": "/invoice-generator",
      "permanent": true
    },
    {
      "source": "/invoice-generator-for-agencies",
      "destination": "/invoice-generator",
      "permanent": true
    },
    {
      "source": "/invoice-generator-for-consultants",
      "destination": "/invoice-generator",
      "permanent": true
    },
    {
      "source": "/invoice-generator-for-designers",
      "destination": "/invoice-generator",
      "permanent": true
    },
    {
      "source": "/invoice-generator-for-developers",
      "destination": "/invoice-generator",
      "permanent": true
    },
    {
      "source": "/invoice-generator-for-photographers",
      "destination": "/invoice-generator",
      "permanent": true
    },
    {
      "source": "/invoice-generator-for-contractors",
      "destination": "/invoice-generator",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/invoice",
      "destination": "/index"
    },
    {
      "source": "/invoice/:path*",
      "destination": "/index"
    },
    {
      "source": "/dashboard",
      "destination": "/index"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/index"
    },
    {
      "source": "/onboarding",
      "destination": "/index"
    },
    {
      "source": "/onboarding/:path*",
      "destination": "/index"
    },
    {
      "source": "/share/:path*",
      "destination": "/index"
    }
  ]
}
