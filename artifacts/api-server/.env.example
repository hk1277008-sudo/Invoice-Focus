# Server-side values. Configure these in Render/Railway, never in Vercel.
PORT=8080
NODE_ENV=production
VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=hello@invoicefocus.com
CLIENT_BASE_URL=https://invoicefocus.com
CORS_ORIGINS=https://invoicefocus.com,https://www.invoicefocus.com

# Optional values used by scheduled recurring-invoice generation and logging.
# RECURRING_CRON_SECRET=replace-with-a-long-random-secret
# LOG_LEVEL=info