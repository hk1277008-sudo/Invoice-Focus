# Public browser-safe values. Configure these in the Vercel project.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Set this to the public HTTPS URL of the separately hosted Express API.
# Leave unset for the Replit artifact proxy during local development.
VITE_API_BASE_URL=https://api.example.com